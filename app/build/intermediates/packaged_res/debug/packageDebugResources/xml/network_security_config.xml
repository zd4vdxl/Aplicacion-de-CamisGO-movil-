<?xml version="1.0" encoding="utf-8"?>
<!--
  Permite tráfico HTTP (sin TLS) SOLO hacia el emulador/servidor local de desarrollo.
  10.0.2.2 es la IP con la que el emulador de Android accede al "localhost" de tu PC,
  donde normalmente corre tu API de .NET Core (dotnet run / IIS Express).
  Elimina este archivo o restringe los dominios antes de publicar la app.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
